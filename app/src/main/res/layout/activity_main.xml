<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_editor_glow"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/closeButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="×"
            android:textColor="#F7F7F8"
            android:textSize="30sp" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Новый проект" android:textColor="#F7F7F8" android:textSize="18sp" android:fontFamily="@font/cormorant_semibold" android:maxLines="1" />
            <TextView android:id="@+id/projectMeta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MP4 · H.264 / AAC" android:textColor="#929BAA" android:textSize="10sp" android:fontFamily="@font/montserrat_regular" />
        </LinearLayout>
        <Button
            android:id="@+id/addVideoButton"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginEnd="6dp"
            android:text="＋ Видео"
            android:textAllCaps="false"
            android:textColor="#F7F7F8"
            android:backgroundTint="#1A2230"
            android:fontFamily="@font/montserrat_medium"
            android:textSize="12sp" />
        <Button
            android:id="@+id/exportButton"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="Экспорт"
            android:textAllCaps="false"
            android:textColor="#101114"
            android:background="@drawable/bg_button_blue"
            android:backgroundTint="@null"
            android:fontFamily="@font/montserrat_semibold"
            android:textSize="13sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:background="#0D1119">
        <androidx.media3.ui.PlayerView
            android:id="@+id/videoPlayer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:surface_type="surface_view"
            app:use_controller="false"
            app:resize_mode="fit"
            app:shutter_background_color="#0D1119" />
        <TextView
            android:id="@+id/stickerOverlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textSize="44sp"
            android:visibility="gone" />
        <LinearLayout
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:background="@drawable/bg_preview_glow">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="▶" android:textColor="#67B8FF" android:textSize="42sp" />
            <TextView android:id="@+id/previewTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Выберите видео" android:textColor="#F7F7F8" android:textSize="16sp" android:fontFamily="@font/montserrat_semibold" />
            <TextView android:id="@+id/previewSubtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Монтаж останется на устройстве" android:textColor="#9CA8B9" android:textSize="12sp" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView android:id="@+id/currentTime" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="00:00.00" android:textColor="#F7F7F8" android:textSize="13sp" android:fontFamily="monospace" />
        <Button android:id="@+id/playButton" android:layout_width="44dp" android:layout_height="44dp" android:minWidth="0dp" android:padding="0dp" android:text="▶" android:textColor="#F7F7F8" android:backgroundTint="#24262C" android:fontFamily="@font/montserrat_semibold" />
        <TextView android:id="@+id/totalTime" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:text="00:00.00" android:textColor="#85868D" android:textSize="13sp" android:fontFamily="monospace" />
    </LinearLayout>

    <SeekBar
        android:id="@+id/timeline"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:layout_marginTop="4dp"
        android:progressTint="#4389FF"
        android:thumbTint="#DCEBFF"
        android:progressBackgroundTint="#303A49" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:layout_marginTop="5dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView android:layout_width="48dp" android:layout_height="wrap_content" android:text="Видео" android:textColor="#85868D" android:textSize="11sp" />
        <LinearLayout android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="14dp" android:paddingEnd="12dp" android:background="@drawable/bg_lane_video">
            <TextView android:id="@+id/clipLabel" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Клип не выбран" android:textColor="#F7F7F8" android:textSize="13sp" android:fontFamily="@font/montserrat_medium" android:maxLines="1" android:ellipsize="middle" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MP4" android:textColor="#898B94" android:textSize="10sp" android:fontFamily="sans-serif-condensed-medium" android:letterSpacing="0.1" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/audioLane"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView android:layout_width="48dp" android:layout_height="wrap_content" android:text="Аудио" android:textColor="#85868D" android:textSize="11sp" />
        <LinearLayout android:id="@+id/audioLaneContent" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="14dp" android:paddingEnd="12dp" android:background="@drawable/bg_lane_audio" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="♫" android:textColor="#71C5FF" android:textSize="17sp" />
            <TextView android:id="@+id/audioTrackLabel" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:paddingStart="9dp" android:text="Исходная дорожка" android:textColor="#D5E5FB" android:textSize="12sp" android:fontFamily="@font/montserrat_medium" android:maxLines="1" android:ellipsize="middle" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ИЗМЕНИТЬ  ›" android:textColor="#76BFFF" android:textSize="9sp" android:fontFamily="@font/montserrat_semibold" android:letterSpacing="0.04" />
        </LinearLayout>
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="5dp"
        android:scrollbars="none">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal">
            <Button android:id="@+id/trimTool" android:layout_width="wrap_content" android:layout_height="44dp" android:layout_marginEnd="8dp" android:minWidth="92dp" android:text="Обрезка" android:textAllCaps="false" android:textColor="#E9F1FF" android:textSize="12sp" android:fontFamily="@font/montserrat_semibold" android:backgroundTint="#1A2230" />
            <Button android:id="@+id/audioTool" android:layout_width="wrap_content" android:layout_height="44dp" android:layout_marginEnd="8dp" android:minWidth="96dp" android:text="Аудио" android:textAllCaps="false" android:textColor="#E9F1FF" android:textSize="12sp" android:fontFamily="@font/montserrat_semibold" android:backgroundTint="#1A2230" />
            <Button android:id="@+id/filterTool" android:layout_width="wrap_content" android:layout_height="44dp" android:layout_marginEnd="8dp" android:minWidth="92dp" android:text="Фильтр" android:textAllCaps="false" android:textColor="#E9F1FF" android:textSize="12sp" android:fontFamily="@font/montserrat_semibold" android:backgroundTint="#1A2230" />
            <Button android:id="@+id/stickerTool" android:layout_width="wrap_content" android:layout_height="44dp" android:text="Текст / стикер" android:textAllCaps="false" android:textColor="#E9F1FF" android:textSize="12sp" android:fontFamily="@font/montserrat_semibold" android:backgroundTint="#1A2230" />
        </LinearLayout>
    </HorizontalScrollView>
</LinearLayout>
